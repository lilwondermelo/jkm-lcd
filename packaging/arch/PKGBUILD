# Maintainer: Arch <arch@local>
pkgname=jkm-lcd
pkgver=3.0.0
pkgrel=1
pkgdesc="Пульт сегментного LCD кулера JKM: сервер, PWA и CLI"
arch=('any')
url="https://github.com/lilwondermelo/jkm-lcd"
license=('MIT')
depends=('python>=3.10')
optdepends=('pulseaudio: громкость и эквалайзер' 'pipewire-pulse: громкость и эквалайзер' 'qrencode: QR-код для привязки' 'nginx: публикация PWA')
source=("$pkgname-$pkgver.tar.gz::https://github.com/lilwondermelo/jkm-lcd/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -d "$pkgdir/usr/share/$pkgname"
  cp -r server web bin docs "$pkgdir/usr/share/$pkgname/"

  install -Dm755 bin/jkmctl "$pkgdir/usr/bin/jkmctl"
  install -Dm644 systemd/jkm-lcd.package.service \
    "$pkgdir/usr/lib/systemd/system/jkm-lcd.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
